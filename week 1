  for(const el of [$('goal'), $('homeGoal')]){
    el.innerHTML='';
    for(const ch of TARGET){const d=document.createElement('div');d.className='t';d.textContent=ch;el.appendChild(d);}
  }
}
function tiles(word){
  const row=document.createElement('div'); row.className='row';
  [...word].forEach((ch,j)=>{
    const t=document.createElement('div'); t.className='tile'+(ch===TARGET[j]?' green':'');
    t.textContent=ch; row.appendChild(t);
  });
  return row;
}
function render(){
  const box=$('ladder'); box.innerHTML='';
  ladder.forEach(w=>box.appendChild(tiles(w)));
  $('count').textContent = (ladder.length-1)+' / '+current.steps;
}
function err(t){$('err').textContent=t||'';}
function clearCells(focus){cells.forEach(c=>c.value=''); if(focus!==false) cells[0].focus();}
function getGuess(){return cells.map(c=>c.value).join('').toUpperCase();}

function newGame(entry){
  current=entry||BANK[Math.floor(Math.random()*BANK.length)];
  ladder=[current.word];
  $('win').textContent=''; err(''); setInputEnabled(true); clearCells(); render();
}
function setInputEnabled(on){cells.forEach(c=>c.disabled=!on);}
function win(){
  const m=ladder.length-1;
  $('win').textContent = m<current.steps ? 'Solved in '+m+' (beat best!)'
    : m===current.steps ? 'Solved in '+m+' (best!)' : 'Solved in '+m;
  setInputEnabled(false);
}
function submit(){
  const g=getGuess(), last=ladder[ladder.length-1];
  if(!/^[A-Z]{4}$/.test(g)){err('four letters');return;}
  if(diff(last,g)!==1){err('change one letter');return;}
  if(g!==TARGET && !VALID.has(g)){err('not a word');return;}
  ladder.push(g); err(''); render();
  if(g===TARGET){clearCells(false); win();} else clearCells();
}

// 4-box input behaviour
cells.forEach((cell,i)=>{
  cell.addEventListener('input',()=>{
    cell.value=cell.value.replace(/[^a-zA-Z]/g,'').toUpperCase().slice(0,1);
    if(cell.value && i<3) cells[i+1].focus();
    if(cell.value && i===3 && cells.every(c=>c.value)) submit();
  });
  cell.addEventListener('keydown',e=>{
    if(e.key==='Backspace' && !cell.value && i>0){cells[i-1].focus(); cells[i-1].value=''; e.preventDefault();}
    else if(e.key==='Enter') submit();
    else if(e.key==='ArrowLeft' && i>0) cells[i-1].focus();
    else if(e.key==='ArrowRight' && i<3) cells[i+1].focus();
  });
});

function bfsNext(from){
  if(from===TARGET) return null;
  const q=[[from]], seen=new Set([from]);
  while(q.length){
    const p=q.shift(), w=p[p.length-1];
    if(w===TARGET) return p[1];
    if(p.length>10) continue;
    for(let i=0;i<4;i++)for(let c=0;c<26;c++){
      const ch=String.fromCharCode(65+c); if(ch===w[i])continue;
      const nw=w.slice(0,i)+ch+w.slice(i+1);
      if(!seen.has(nw)&&(nw===TARGET||VALID.has(nw))){seen.add(nw);q.push([...p,nw]);}
    }
  }
  return null;
}
$('newBtn').onclick=()=>newGame();
$('undoBtn').onclick=()=>{if(ladder.length>1){ladder.pop();$('win').textContent='';setInputEnabled(true);clearCells();render();}};
$('hintBtn').onclick=()=>{const n=bfsNext(ladder[ladder.length-1]); if(n) $('err').textContent='try '+n;};
$('rulesBtn').onclick=()=>$('overlay').classList.add('show');
$('closeRules').onclick=()=>{$('overlay').classList.remove('show'); if(!$('home').classList.contains('hide')) return; cells[0].focus();};
$('overlay').onclick=e=>{if(e.target===$('overlay')){$('overlay').classList.remove('show');}};
$('homeRules').onclick=()=>$('overlay').classList.add('show');

function startPlaying(){$('home').classList.add('hide'); newGame();}
$('playBtn').onclick=startPlaying;

renderGoal();
</script>
</body>
</html>
